# Copy to .env and fill in. Never commit .env. Placeholders only.

# OpenAI (optional: without it the app runs offline or with saved answers)
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Supabase (optional: set all three for permanent storage, or none for local storage)
# Project URL, from Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key (server side only; never expose it to a browser)
SUPABASE_KEY=your-service-role-key
# Connection string -> "Session pooler" (works on IPv4 hosts such as Streamlit Cloud)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_STORAGE_BUCKET=supplier-documents

